# Environment Config
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/carbonsphere

# JWT Secret
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRE=30d

# Groq API Keys (Multiple keys for load balancing & failover)
GROQ_API_KEY_1=gsk_your_key_1
GROQ_API_KEY_2=gsk_your_key_2
GROQ_API_KEY_3=gsk_your_key_3

# Fallback (optional)
GROQ_API_KEY=gsk_your_legacy_key
